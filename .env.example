# Application
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=pickle_pos
POSTGRES_USER=pickle_pos
POSTGRES_PASSWORD=pickle_pos_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pickle_pos:pickle_pos_dev@postgres:5432/pickle_pos

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT (Mobile API)
JWT_SECRET_KEY=change-me-jwt-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Django
DJANGO_SETTINGS_MODULE=config.settings.development

# FastAPI
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=7101

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:7100

# Security (Phase 7)
# Rate limits apply automatically when APP_ENV=production
RATE_LIMIT_ENABLED=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
LOGIN_RATE_LIMIT=20
API_RATE_LIMIT=120
AUDIT_RETENTION_DAYS=365
# Enable only behind TLS
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
